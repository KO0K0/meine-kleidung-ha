
<a class="skip-link" href="#inventory-content">Zum Bestand springen</a>
<main class="closet" hx-boost="false">
  <header class="closet-header">
    <div>
      <p class="eyebrow">DEIN DIGITALER KLEIDERSCHRANK</p>
      <h1 id="view-title">Meine Kleidung</h1>
      <p id="view-description">Alles an seinem Platz.</p>
    </div>
    <div class="closet-header-actions">
      <button type="button" class="tools-trigger" popovertarget="closet-tools" aria-label="Schrank-Werkzeuge öffnen" title="Schrank erfassen, Sicherung und Konto"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="5" cy="12" r="1"/><circle cx="12" cy="12" r="1"/><circle cx="19" cy="12" r="1"/></svg></button>
      <button
        id="open-voice"
        type="button"
        aria-label="Sprachliste öffnen"
        title="Sprachliste"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <rect x="9" y="2" width="6" height="12" rx="3" />
          <path d="M5 10v2a7 7 0 0 0 14 0v-2M12 19v3m-4 0h8" />
        </svg>
      </button>
      <a class="primary" href="/wardrobe/new">＋ <span>Artikel hinzufügen</span></a>
    </div>
  </header>
  <nav class="closet-tabs" aria-label="Kleidungsverwaltung">
    <a class="nav-brand" href="/inventory"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 4-5 2-3 5 4 2 2-2v9h10v-9l2 2 4-2-3-5-5-2a3 3 0 0 1-6 0Z"/></svg><span>Mein Schrank</span></a>
    <button data-tab="all" aria-pressed="true"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="2"/><rect x="14" y="3" width="7" height="7" rx="2"/><rect x="3" y="14" width="7" height="7" rx="2"/><rect x="14" y="14" width="7" height="7" rx="2"/></svg><span>Übersicht</span></button>
    <button data-tab="laundry" aria-pressed="false">
<svg viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="3" width="14" height="18" rx="2"/><path d="M5 8h14"/><circle cx="12" cy="14" r="3"/></svg><span>Wäsche <b id="laundry-count">0</b></span>
    </button>
    <button data-tab="luggage" aria-pressed="false"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="6" width="16" height="15" rx="3"/><path d="M9 6V3h6v3M9 10v7m6-7v7"/></svg><span>Gepäck</span></button>
    <button data-tab="places" aria-pressed="false"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 10c0 6-8 11-8 11S4 16 4 10a8 8 0 1 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg><span>Orte</span></button>
  </nav>
  <div id="closet-tools" class="closet-tools" popover><h2>Dein Schrank</h2><button id="open-assistant" type="button">KI-Assistent · ausprobieren</button>  <details class="backup-tools capture-tools">
    <summary>Schrank erfassen</summary>
    <p>Viele Kleidungsstücke nacheinander aufnehmen. Kategorie und Ort einmal wählen und für die nächsten Artikel beibehalten.</p>
    <a class="primary" href="/wardrobe/new?capture=1">Schrank-Erfassung starten</a>
  </details>
  <details class="backup-tools">
    <summary>Sicherung &amp; Import</summary>
    <p>
      Eine Sicherung enthält deinen Bestand mit Fotos. Importiere sie in einen
      leeren Bestand.
    </p>
    <a class="primary" href="/inventory/backup" download
      >Sicherung herunterladen</a
    >
    <form id="backup-import">
      <label
        >Sicherungsdatei<input
          type="file"
          id="backup-file"
          accept=".json,application/json"
          required
      /></label>
      <button type="submit">Importieren</button>
    </form>
  </details>
  <footer>
    Basierend auf
    <a
      href="https://github.com/Lazztech/Libre-Closet"
      target="_blank"
      rel="noopener"
      >Libre Closet</a
    >
    {{#if authEnabled}} · <a href="/auth/profile">Konto</a>{{/if}}
  </footer>
</div>
  <p id="inventory-message" role="status" aria-live="polite"></p>
  <button id="undo-action" type="button" hidden>Rückgängig</button>
  <section id="inventory-content" tabindex="-1">
    <div class="closet-stats" id="inventory-stats"></div>
    <div class="closet-filters" role="search" aria-label="Kleidung suchen und filtern">
      <label class="search-label"
        >Suche<input
          id="inventory-search"
          type="search"
          placeholder="Name, Marke, Größe, Farbe …"
      /></label>
      <details id="filter-options" class="filter-options" open>
        <summary>Filter <span id="filter-count"></span></summary>
        <div class="filter-fields">
      <label
        >Ort<select id="inventory-location">
          <option value="">Alle Orte</option>
        </select></label
      >
      <label
        >Kategorie<select id="inventory-category">
          <option value="">Alle Kategorien</option>
        </select></label
      >
      <label
        >Status<select id="inventory-status">
          <option value="">Alle</option>
          <option value="available">Verfügbar</option>
          <option value="laundry">In der Wäsche</option>
        </select></label
      >
        </div>
      </details>
    </div>
    <div id="active-filters" class="active-filters" aria-label="Aktive Filter"></div>
    <div class="selection-bar">
      <label
        ><input type="checkbox" id="select-visible" /> Sichtbare auswählen</label
      >
      <span id="result-count" class="result-count" role="status"></span><button id="refresh-inventory" type="button" title="Bestand aktualisieren" aria-label="Bestand aktualisieren"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 7v5h-5M4 17v-5h5M6 6a8 8 0 0 1 13 3M5 15a8 8 0 0 0 13 3"/></svg></button>
    </div>
    <div id="inventory-grid" class="closet-grid" aria-live="polite"></div>
    <div class="batch-bar" id="batch-bar" hidden>
      <strong id="selection-count"></strong>
      <button
        id="clear-selection"
        type="button"
        aria-label="Auswahl aufheben"
        title="Auswahl aufheben"
      >
        ×
      </button>
      <button id="wash-selection">In die Wäsche</button>
      <button id="clean-selection">Wieder verfügbar</button>
      <label>Zielort<select id="move-destination"></select></label>
      <button id="move-selection" class="primary">Verschieben</button>
    </div>
  </section>
  <section id="inventory-places" hidden>
    <h2>Deine Orte</h2>
    <p>
      Namen kannst du jederzeit ändern. Die zugeordneten Mengen bleiben
      erhalten.
    </p>
    <div id="place-list"></div>
    <form id="add-place">
      <label
        >Weiterer Ort<input
          name="name"
          maxlength="60"
          required
          placeholder="Zum Beispiel Ferienwohnung" /></label
      ><button class="primary">Ort hinzufügen</button>
    </form>
  </section>
  <div class="scroll-tools" aria-label="Schnellnavigation">
    <button
      id="floating-search-button"
      type="button"
      popovertarget="floating-search-panel"
      aria-label="Suche öffnen"
      title="Suche öffnen"
      hidden
    >
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <circle cx="10.5" cy="10.5" r="6.5" />
        <path d="m16 16 4 4" />
      </svg>
    </button>
    <button
      id="back-to-top"
      type="button"
      aria-label="Nach ganz oben"
      title="Nach ganz oben"
      hidden
    >
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M12 19V5m-6 6 6-6 6 6" />
      </svg>
    </button>
  </div>
  <div id="floating-search-panel" class="floating-search-panel" popover>
    <label
      >Suche<input
        id="floating-search"
        type="search"
        placeholder="Name, Marke, Größe, Farbe …"
        autofocus
    /></label>
    <button
      type="button"
      popovertarget="floating-search-panel"
      popovertargetaction="hide"
      aria-label="Suche schließen"
    >
      ×
    </button>
  </div>
</main>
<dialog
  id="move-preview"
  class="stock-dialog"
  aria-labelledby="move-preview-title"
  hx-boost="false"
>
  <form method="dialog">
    <header>
      <h2 id="move-preview-title">Verschieben</h2>
      <button value="cancel" aria-label="Schließen">×</button>
    </header>
    <p id="move-preview-target"></p>
    <ul id="move-preview-entries"></ul>
    <button class="primary" value="confirm">Jetzt verschieben</button>
  </form>
</dialog>
<dialog
  id="stock-dialog"
  class="stock-dialog"
  aria-labelledby="stock-title"
  hx-boost="false"
>
    <header>
      <h2 id="stock-title">Mengen verteilen</h2>
      <button type="button" id="close-stock" aria-label="Schließen">×</button>
    </header>
    <nav class="article-sections" aria-label="Artikelbereiche"><button id="article-stock-tab" type="button" aria-pressed="true" aria-controls="stock-form">Mengen &amp; Orte</button><button id="article-details-tab" type="button" aria-pressed="false" aria-controls="article-details">Details &amp; Foto</button></nav>
  <section id="article-details" class="article-details" aria-label="Details und Foto" hidden></section>
  <form id="stock-form">
    <p id="stock-instruction">Mit − Stücke abziehen und mit + neu zuweisen.</p>
    <p id="stock-pool" aria-live="polite"></p>
    <div class="stock-head">
      <span>Ort</span><span>Verfügbar</span><span>Wäsche</span>
    </div>
    <div id="stock-inputs"></div>
    <label class="stock-correction">
      <input id="stock-correction" type="checkbox" /> Gesamtzahl korrigieren
    </label>
    <p id="stock-error" role="alert"></p>
    <button id="stock-save" class="primary" type="submit">
      Verteilung speichern
    </button>
  </form>
</dialog>
<dialog
  id="voice-dialog"
  class="stock-dialog"
  aria-labelledby="voice-title"
  hx-boost="false"
>
  <header>
    <h2 id="voice-title">Sprachliste</h2>
    <button id="close-voice" type="button" aria-label="Schließen">×</button>
  </header>
  <div class="voice-places">
    <label>Von<select id="voice-source"></select></label>
    <label>Nach<select id="voice-target"></select></label>
  </div>
  <div class="voice-route-tools">
    <button
      id="voice-swap"
      type="button"
      title="Richtung umkehren"
      aria-label="Richtung umkehren"
    >
      ⇄
    </button>
    <button id="voice-save-route" type="button">Richtung merken</button>
  </div>
  <div id="voice-routes" aria-label="Gespeicherte Ortsrichtungen"></div>
  <label for="voice-text">Artikel diktieren oder schreiben</label>
  <textarea
    id="voice-text"
    rows="4"
    placeholder="Zwei Zip-Hoodies, ein T-Shirt, Strümpfe"
  ></textarea>
  <p class="voice-hint">
    Tippe ins Textfeld und nutze das Mikrofon deiner iPhone-Tastatur oder unter
    Windows die Windows-Taste + H. Trenne Artikel mit „Komma“ oder einer neuen
    Zeile. Ohne Mengenangabe wird ein Stück ausgewählt. Es zählen nur verfügbare
    Artikel am Startort.
  </p>
  <button id="voice-match" type="button">Artikel zuordnen</button>
  <p id="voice-error" role="status" aria-live="polite"></p>
  <div id="voice-results"></div>
  <button id="voice-confirm" class="primary" type="button" disabled>
    Jetzt verschieben
  </button>
</dialog>
<dialog id="assistant-dialog" class="stock-dialog" aria-labelledby="assistant-title" hx-boost="false">
<header><h2 id="assistant-title">Kleidungsassistent</h2><button id="assistant-close" type="button" aria-label="Assistent schließen">×</button></header>
<p>Bestand finden, Kleidung verschieben und Wäsche verwalten. Änderungen bestätigst du selbst.</p>
<label for="assistant-provider">Anbieter</label><select id="assistant-provider"></select>
<p id="assistant-status" role="status" aria-live="polite"></p>
<div id="assistant-history" class="assistant-history" role="log" aria-label="Gespräch"></div>
<div id="assistant-result" aria-label="Ergebnis und Auftragsvorschau"></div>
<button id="assistant-confirm" class="primary" type="button" hidden>Auftrag bestätigen</button>
<form id="assistant-form"><label for="assistant-text">Auftrag oder Antwort</label><textarea id="assistant-text" rows="3" maxlength="4000" placeholder="Zwei Hoodies von Wohnung A nach Wohnung B …"></textarea><p>Zum Sprechen das Mikrofon deiner Tastatur verwenden.</p><button id="assistant-send" class="primary" type="submit">Verstehen</button><button id="assistant-new" type="button">Neues Gespräch</button></form>
</dialog>
<script src="/js/assistant.js" defer></script>
<script src="/js/voice-list.js" defer></script>
<script src="/js/inventory.js" defer></script>
