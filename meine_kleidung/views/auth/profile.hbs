{{>navbar}}
<main class="account-page">
  <section class="account-card"><p class="eyebrow">DEIN KONTO</p><h1>Kontoeinstellungen</h1><p class="account-email">{{user.email}}</p>
  <nav class="account-links" aria-label="Kontoeinstellungen">
    <a href="/auth/update-email">E-Mail-Adresse ändern <span aria-hidden="true">→</span></a>
    <a href="/auth/reset?email={{user.email}}">Passwort ändern <span aria-hidden="true">→</span></a>
    {{#if authEnabled}}<a href="/wardrobe-share/manage">Zugriff verwalten <span aria-hidden="true">→</span></a>{{/if}}
    <a href="/auth/delete-account" class="danger-link">Konto löschen <span aria-hidden="true">→</span></a>
  </nav></section>
</main>{{>dock}}
