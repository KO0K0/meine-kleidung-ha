<link rel="stylesheet" href="/css/inventory.css" />
<main class="closet-editor" hx-boost="false">
  <div class="closet-sheet">
    <div class="flex items-center gap-3 mb-6">
      <a
        href="{{#if garment}}/wardrobe/{{garment.id}}{{#if viewOwner}}?ownerId={{viewOwner}}{{/if}}{{else}}/inventory{{/if}}"
        class="btn btn-ghost btn-sm btn-circle"
        aria-label="Zurück"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="2"
          stroke="currentColor"
          class="size-4"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18"
          />
        </svg>
      </a>
      <h1 class="text-2xl font-bold">
        {{#if isClone}}{{t 'lang.CLONE_GARMENT'}}{{else if garment}}{{t
        'lang.EDIT_GARMENT'}}{{else}}{{t 'lang.NEW_GARMENT'}}{{/if}}
      </h1>
    </div>

    <form
      method="POST"
      action="{{#if isClone}}/wardrobe/{{garment.id}}/clone{{#if viewOwner}}?ownerId={{viewOwner}}{{/if}}{{else if garment}}/wardrobe/{{garment.id}}{{#if viewOwner}}?ownerId={{viewOwner}}{{/if}}{{else}}/wardrobe{{#if viewOwner}}?ownerId={{viewOwner}}{{/if}}{{/if}}"
      class="flex flex-col gap-4"
      {{#unless garment}}id="new-garment-form" enctype="multipart/form-data"{{/unless}}
    >
      {{#unless garment}}
      <section class="new-garment-photo" aria-labelledby="new-photo-heading">
        <h2 id="new-photo-heading">Kleidungsfoto <span class="text-sm font-normal">(optional)</span></h2>
        <div class="new-photo-preview">
          <img id="new-photo-preview" alt="Vorschau des ausgewählten Kleidungsstücks" hidden />
          <span id="new-photo-placeholder">Foto zuerst aufnehmen oder auswählen</span>
        </div>
        <div class="new-photo-actions">
          <label class="btn btn-outline btn-sm" for="new-photo-input">Bild auswählen</label>
          <input id="new-photo-input" type="file" name="photo" accept="image/jpeg,image/png,image/webp,image/gif" class="new-photo-file" />
          <button id="new-photo-camera" type="button" class="btn btn-outline btn-sm" aria-label="Kleidungsfoto aufnehmen" title="Foto aufnehmen">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M3 7h4l2-3h6l2 3h4v14H3z"/><circle cx="12" cy="13" r="4"/></svg>
          </button>
          <input id="new-photo-capture" type="file" accept="image/jpeg,image/png,image/webp,image/gif" capture="environment" hidden />
          <button id="new-photo-remove" type="button" class="btn btn-ghost btn-sm" aria-label="Ausgewähltes Foto entfernen" title="Foto entfernen" hidden>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M4 7h16M9 7V4h6v3M6 7l1 14h10l1-14M10 10v8m4-8v8"/></svg>
          </button>
        </div>
        <button id="new-photo-cutout" type="button" class="btn btn-outline btn-sm" hidden>Hintergrund entfernen</button>
        <p id="new-photo-status" role="status" aria-live="polite" class="text-sm">Du kannst die Angaben auch ohne Foto speichern. Maximal 20 MB.</p>
      </section>
      <div id="new-garment-error" class="alert alert-error" role="alert" hidden></div>
      {{/unless}}
      <div class="form-control">
        <label class="label"
          ><span class="label-text">{{t 'lang.NAME'}}</span></label
        >
        <input
          type="text"
          name="name"
          class="input input-bordered"
          value="{{#if isClone}}{{cloneName}}{{else if garment}}{{garment.name}}{{/if}}"
          placeholder="z. B. Schwarzes Leinenhemd"
        />
      </div>

      <div class="form-control">
        <label class="label"
          ><span class="label-text">{{t 'lang.CATEGORY'}} *</span></label
        >
        <input
          type="text"
          name="category"
          list="category-suggestions"
          class="input input-bordered w-full"
          value="{{#if garment}}{{garment.category}}{{/if}}"
          required
          placeholder="{{t 'lang.TYPE_OR_SELECT_CATEGORY'}}"
          autocomplete="off"
        />
        <datalist id="category-suggestions">
          {{#each categories}}
          <option value="{{this.value}}"></option>
          {{/each}}
        </datalist>
      </div>

      <div class="form-control">
        <label class="label"
          ><span class="label-text">{{t 'lang.BRAND'}}</span></label
        >
        <input
          type="text"
          name="brand"
          class="input input-bordered"
          value="{{#if garment}}{{garment.brand}}{{/if}}"
          placeholder="z. B. Levi's"
        />
      </div>

      {{> colorMultiSelect colors=colors garment=garment}}

      <div class="form-control">
        <label class="label"
          ><span class="label-text">{{t 'lang.SIZE'}}</span></label
        >
        <input
          type="text"
          name="size"
          class="input input-bordered"
          value="{{#if garment}}{{garment.size}}{{/if}}"
          placeholder="M, 32, Einheitsgröße …"
        />
      </div>

      <div class="form-control">
        <label class="label"
          ><span class="label-text">{{t 'lang.WASHING_DETAILS'}}</span></label
        >
        <textarea
          name="washingDetails"
          class="textarea textarea-bordered"
          rows="3"
          placeholder="Bei 30 °C waschen …"
        >
{{#if garment}}{{garment.washingDetails}}{{/if}}</textarea
        >
      </div>

      <div class="form-control">
        <label class="label"
          ><span class="label-text">{{t 'lang.DATE_AQUIRED'}}</span></label
        >
        <input
          type="date"
          name="dateAquired"
          class="input input-bordered"
          value="{{formatDate garment.dateAquired}}"
        />
      </div>

      <div class="form-control">
        <label class="label"
          ><span class="label-text">{{t 'lang.NOTES'}}</span></label
        >
        <textarea
          name="notes"
          class="textarea textarea-bordered"
          rows="3"
          placeholder="Notizen zu diesem Kleidungsstück …"
        >
{{#if garment}}{{garment.notes}}{{/if}}</textarea
        >
      </div>

      <div class="flex gap-2 mt-2">
        <a
          href="{{#if garment}}/wardrobe/{{garment.id}}{{#if viewOwner}}?ownerId={{viewOwner}}{{/if}}{{else}}/inventory{{/if}}"
          class="btn btn-ghost flex-1"
          >{{t 'lang.CANCEL'}}</a
        >
        <button type="submit" class="btn btn-primary flex-1">
          {{t 'lang.SAVE'}}
        </button>
      </div>
    </form>
  </div>
</main>
{{#unless garment}}<script type="module" src="/js/garment-create.js"></script>{{/unless}}
